# VistoOS · linux/visto-kiosk.service — der Kiosk: cage (Wayland) + Browser auf device.html
#
# STATUS: Vorlage, auf echter Visto-Hardware UNGETESTET.
#
# Installieren:  cp visto-kiosk.service /etc/systemd/system/ && systemctl enable visto-kiosk.service
# Läuft als Benutzer „visto“ auf tty1 und ersetzt dort die Anmeldung (wie ein Display-Manager).
# Einstellungen: /etc/default/visto (siehe start-kiosk.sh)

[Unit]
Description=VistoOS-Kiosk (cage + Browser auf device.html)
Documentation=file:///opt/visto/linux/README.md
After=systemd-user-sessions.service plymouth-quit-wait.service getty@tty1.service vistod.service
Wants=vistod.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=visto
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
EnvironmentFile=-/etc/default/visto
Environment=XDG_SESSION_TYPE=wayland
ExecStart=/usr/bin/cage -d -s -- /opt/visto/linux/start-kiosk.sh
Restart=always
RestartSec=2

[Install]
WantedBy=graphical.target
Alias=display-manager.service
